# W3.5.95 self-observability lab — local-first on oMLX (Apple Silicon).
# Copy to .env. Everything runs against local oMLX :8000 (no cloud, no metered proxy).

# Agent decision model (the "agent" picking tools) — capable local model.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
MODEL_AGENT=Qwen2.5-Coder-14B-Instruct-MLX-4bit

# LEARNING extractor — a SEPARATE, SMALLER model on purpose (chapter §2.2/decision 5):
# the agent's own model would echo-chamber its biases into its self-knowledge.
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=dummy
MODEL_EXTRACTOR=Qwen2.5-Coder-7B-Instruct-MLX-4bit

# Recall + extractor tuning (optional)
LEARNING_MIN_CONFIDENCE=0.55
