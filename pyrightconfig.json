{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",

  "extraPaths": [
    "shared"
  ],

  "executionEnvironments": [
    {
      "comment": "lab-04 src files use `from src.x import` + import web_toolkit; root at the lab dir so both resolve, and tests/ resolve `src.*` too",
      "root": "lab-04-react-from-scratch",
      "extraPaths": [
        "../shared",
        "shared"
      ]
    },
    {
      "root": "lab-02-5-graphrag/src",
      "extraPaths": [
        "../../shared",
        "../../lab-02-rerank-compress/src"
      ]
    },
    {
      "root": "lab-02-rerank-compress/src",
      "extraPaths": [
        "../../shared"
      ]
    },
    {
      "root": "shared",
      "extraPaths": [
        "."
      ]
    }
  ],

  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none",

  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/node_modules"
  ]
}
