# .env — copy to .env and fill in
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=changeme

# Tree backend isolation pattern (W2.7 Bad-Case Entry 6) — separate model
# for tools-using calls vs no-tools calls keeps server KV cache clean.
MODEL_SONNET=gemma-4-26B-A4B-it-heretic-4bit
MODEL_HAIKU=gemma-4-26B-A4B-it-heretic-4bit

# Self-RAG / Corrective thresholds (ported from shaneliuyx/rag config/settings.py)
SELFRAG_CONF_THRESHOLD=0.6
RELEVANCE_THRESHOLD=0.2
MAX_REGEN_ATTEMPTS=1
MAX_REWRITE_ATTEMPTS=2

# Qdrant collection (reuses lab-03 dev set OR a corpus you've ingested separately)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=bge_m3_hnsw

# Optional: enable LLM-driven query decomposition on the CORPUS path (Phase 7).
# Note: the WEB-fallback path fans out via decomposition automatically for Complex
# queries regardless of this flag — this gates only the in-corpus multi-hop path.
ENABLE_DECOMPOSITION=0

# Web-fallback backend (web_search precedence: SEARXNG_URL → TAVILY_API_KEY → DuckDuckGo).
# SearXNG is the free, no-key, best-ranking option — start it with searxng/docker-compose.yml
# then set this. Falls back to DuckDuckGo if unset and no Tavily key.
SEARXNG_URL=http://localhost:8080
# TAVILY_API_KEY=tvly-...        # optional managed fallback; ranks paywalled aggregators high
# WEB_FANOUT_K=8                 # per-sub-query web depth when a Complex query fans out
