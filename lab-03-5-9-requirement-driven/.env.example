# oMLX local backend (generation + embeddings)
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=your-omlx-key-here
# models
MODEL_EMBED=bge-m3-mlx-fp16
MODEL_HAIKU=gemma-4-26B-A4B-it-heretic-4bit   # consolidation (qdrant summarize) + dedup + mem0 — gemma verified OK for all; retires the slow gpt-oss-20b
# EverCore HTTP service
EVERCORE_HTTP_TIMEOUT_S=600
PER_QUESTION_CAP_S=1200
# atomic-fact extraction model (benchmarked: best recall, ~5x faster than gpt-oss-20b)
MODEL_EXTRACT=gemma-4-26B-A4B-it-heretic-4bit
# reader/answer model (set empty or to gpt-oss-20b to compare)
MODEL_READER=gemma-4-26B-A4B-it-heretic-4bit
# mem0 NLP extras: after `uv sync`, run: uv run python -m spacy download en_core_web_sm
