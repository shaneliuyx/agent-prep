# lab-04-react-from-scratch — copy to .env and adjust:
#   cp .env.example .env
# Load it before running (or let your shell/uv pick it up):
#   set -a; source .env; set +a

# --- oMLX engine (one OpenAI-compatible endpoint, model-routed) ---
OMLX_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=not-needed          # oMLX ignores auth; the OpenAI SDK needs non-empty

# --- model tiers (BARE served ids from GET /v1/models; no models/ prefix) ---
MODEL_SONNET=gemma-4-26B-A4B-it-heretic-4bit                              # workhorse / default (most roles)
MODEL_FAST=Qwen3.5-4B-MLX-4bit                                           # classify — fast, all 4 dims, structured tools
MODEL_OPUS=Qwen3.5-27B-Claude-4.6-Opus-Distilled-MLX-4bit                # hard_loop — larger reasoning attempt
MODEL_HAIKU=MLX-Qwen3.5-35B-A3B-Claude-4.6-Opus-Reasoning-Distilled-4bit  # fast tool-only (think-blocks fail strict format)

# --- ReAct loop guards (optional; defaults live in src/react.py) ---
# REACT_MAX_ITER=12
# REACT_CTX_LIMIT=28000

# --- web_search backend (read by shared/web_toolkit, not by lab code) ---
# Backend is config-selected, NOT runtime failover. SearXNG when SEARXNG_URL is
# set (W3.7 docker setup); set it EMPTY to fall through to DuckDuckGo
# (uv pip install ddgs). A configured-but-down SearXNG raises a SearchError
# (web_search returns it as an error string) — it does NOT auto-fall-back.
SEARXNG_URL=http://localhost:8080
# TAVILY_API_KEY=        # optional alternative backend (takes precedence over DDG)
